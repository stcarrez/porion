#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

$(foreach line,$(shell sed -n '\
  s/^ gnat, gnat-\([0-9.]\+\),$$/ \
    GNAT_VERSION:=\1 \
  /p;\
  ' debian/control),$(eval $(line)))

DH_VERBOSE=1
export DH_OPTIONS=-v

DEB_BUILD_MAINT_OPTIONS := hardening=+all
include /usr/share/dpkg/buildflags.mk
include /usr/share/ada/debian_packaging-$(GNAT_VERSION).mk
ADAFLAGS += -gnatafno -gnatVa -gnatwa

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --

override_dh_auto_build:
	$(MAKE) GNATMAKE="gprbuild -R -m -q"

override_dh_auto_test::

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/tmp prefix=/usr install
	dh_install debian/tmp/usr/bin/porion /usr/bin
	dh_install -pporion-server bin/porion-server /usr/bin
	dh_installman debian/tmp/usr/share/man/man1/porion.1
	dh_installman --package=porion-server debian/tmp/usr/share/man/man8/porion-server.8
	dh_installsystemd --package=porion-server
	dh_strip
	files=`cd $(CURDIR)/debian/tmp/usr/share/porion/resources && find . -type f`; \
        for i in $$files; do \
	  dir=`dirname $$i`; \
	  dh_install debian/tmp/usr/share/porion/resources/$$i usr/share/porion/resources/$$dir ; \
        done
	files=`cd $(CURDIR)/debian/tmp/usr/share/porion/rules && find . -type f`; \
        for i in $$files; do \
	  dir=`dirname $$i`; \
	  dh_install debian/tmp/usr/share/porion/rules/$$i usr/share/porion/rules/$$dir ; \
        done
	files=`cd $(CURDIR)/debian/tmp/usr/share/locale && find . -type f`; \
        for i in $$files; do \
	  dir=`dirname $$i`; \
	  dh_installdirs usr/share/locale/$$dir; \
	  dh_install debian/tmp/usr/share/locale/$$i usr/share/locale/$$dir ; \
        done
	$(MAKE) DESTDIR=$(CURDIR)/debian/tmp/usr/share prefix=/usr DIST_DIR=/porion \
	   PACKAGE_XML=$(CURDIR)/debian/package.xml server-package
	files=`cd $(CURDIR)/debian/tmp/usr/share/porion/web && find . -type f`; \
        for i in $$files; do \
	  dir=`dirname $$i`; \
	  dh_installdirs --package=porion-server usr/share/porion/web/$$dir; \
	  dh_install -pporion-server debian/tmp/usr/share/porion/web/$$i usr/share/porion/web/$$dir ; \
        done
	dh_installdirs --package=porion-server usr/share/porion/bundles
	files=`cd $(CURDIR)/debian/tmp/usr/share/porion/bundles && find . -type f`; \
        for i in $$files; do \
	  dh_install -pporion-server debian/tmp/usr/share/porion/bundles/$$i usr/share/porion/bundles ; \
        done
	files=`cd $(CURDIR)/debian/tmp/usr/share/porion/config && find . -type f`; \
        for i in $$files; do \
	  dir=`dirname $$i`; \
	  dh_installdirs --package=porion-server usr/share/porion/config/$$dir; \
	  dh_install -pporion-server debian/tmp/usr/share/porion/config/$$i usr/share/porion/config/$$dir ; \
        done
	dh_install -pporion-server share/porion/config/porion.properties usr/share/porion/config
	#rm -rf debian/tmp
