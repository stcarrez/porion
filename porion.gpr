with "porion_config";
aggregate project Porion is

   for Project_Path use ("awa/ada-util",
                         "awa/ada-util/xml",
                         "awa/ada-util/aws",
                         "awa/ada-util/unit",
                         "awa/ada-el",
                         "awa/ada-keystore/akt",
                         "awa/ada-keystore",
                         "awa/ada-ado/sqlite",
                         "awa/ada-ado/mysql",
                         "awa/ada-ado/postgresql",
                         "awa/ada-ado/drivers",
                         "awa/ada-ado",
                         "awa/ada-security",
                         "awa/ada-servlet/aws",
                         "awa/ada-servlet",
                         "awa/ada-asf",
                         "awa/ada-wiki",
                         "awa/openapi-ada",
                         "awa/openapi-ada/server",
                         "awa/dynamo",
                         "awa/awa",
                         "resource-embedder",
			 "ansi-ada");

   for Create_Missing_Dirs use "True";

   Build_Are    : Porion_Config.Yes_No := external ("BUILD_ARE", "yes");
   Build_Dynamo : Porion_Config.Yes_No := external ("BUILD_DYNAMO", "yes");

   for Project_Files use ("porion_lib.gpr", "agent/porion_agent.gpr", "porion_tests.gpr", "server/porion_server.gpr");

   case Build_Are is
      when "yes" =>
         for Project_Files use Project'Project_Files & ("resource-embedder/are_tool.gpr");

      when others =>
         null;

   end case;

   case Build_Dynamo is
      when "yes" =>
         for Project_Files use Project'Project_Files & ("awa/dynamo/dynamo_tool.gpr");

      when others =>
         null;

   end case;

end Porion;
