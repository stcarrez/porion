with "porion_config";
aggregate project Porion is

   for Project_Path use ("awa/ada-util/.alire",
                         "awa/ada-util/.alire/xml",
                         "awa/ada-util/.alire/aws",
                         "awa/ada-util/.alire/unit",
                         "awa/ada-util",
                         "awa/ada-el/.alire",
                         "awa/ada-el",
                         "awa/ada-keystore/.alire",
                         "awa/ada-keystore",
                         "awa/ada-ado/.alire/sqlite",
                         "awa/ada-ado/.alire/mysql",
                         "awa/ada-ado/.alire/postgresql",
                         "awa/ada-ado/.alire/all",
                         "awa/ada-ado/.alire",
                         "awa/ada-ado",
                         "awa/ada-security/.alire",
                         "awa/ada-security",
                         "awa/ada-servlet/.alire",
                         "awa/ada-servlet/.alire/aws",
                         "awa/ada-servlet",
                         "awa/ada-asf/.alire",
                         "awa/ada-asf",
                         "awa/ada-wiki/.alire",
                         "awa/ada-wiki",
                         "awa/ada-wiki/.alire",
                         "awa/openapi-ada/.alire",
                         "awa/dynamo/.alire",
                         "awa/.alire",
                         "awa/awa",
                         "resource-embedder");

   for Create_Missing_Dirs use "True";

   Build_Are    : Porion_Config.Yes_No := external ("BUILD_ARE", "yes");
   Build_Dynamo : Porion_Config.Yes_No := external ("BUILD_DYNAMO", "yes");

   for Project_Files use ("porion_lib.gpr", "agent/porion_agent.gpr", "porion_tests.gpr", "server/porion_server.gpr");

   case Build_Are is
      when "yes" =>
         for Project_Files use Project'Project_Files & ("resource-embedder/are_tool.gpr");

      when others =>
         null;

   end case;

   case Build_Dynamo is
      when "yes" =>
         for Project_Files use Project'Project_Files & ("awa/dynamo/.alire/dynamo.gpr");

      when others =>
         null;

   end case;

end Porion;
