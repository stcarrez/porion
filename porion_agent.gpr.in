with "@UTIL_DIR@config";
with "@UTIL_DIR@utilada_sys";

with "porion_lib";

project Porion_Agent is

   for Languages use ("Ada");

   Mains := ("porion-main.adb");

   for Source_Dirs use ("src/agent");

   for Main use Mains;

   for Object_Dir use "./" & Config'Object_Dir & "/obj";
   for Exec_Dir use "./" & Config'Exec_Dir & "/bin";

   package binder is
      case Config.Mode is
         when "debug" =>
            for Default_Switches ("Ada") use ("-E");

         when others =>
            for Default_Switches ("Ada") use ("-E");

      end case;
   end binder;

   package Builder is
      for Default_Switches ("Ada") use
         Config.Builder'Default_Switches ("Ada");
      for Executable ("porion-main.adb") use "porion";
   end Builder;

   package Linker is
      for Default_Switches ("Ada") use Config.Linker'Default_Switches ("Ada");
   end Linker;

   package Compiler renames Config.Compiler;

end Porion_Agent;
