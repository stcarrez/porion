with "porion_config";
with "utilada_sys";
with "elada";
with "ado";
--  with "yaml";
with "ado_sqlite";
with "security";
with "keystoreada";
with "intl";

with "printer-toolkit/printer_toolkit";

library project Porion_Lib is

   Library_Dir := "lib";
   Version     := "0.15.0";

   for Languages use ("Ada", "C");

   for Library_Name use "porion";
   for Library_Kind use "static";
   for Library_Version use "lib" & Project'Library_Name & ".so." & Version;

   for Source_Dirs use ("src", "src/model", "src/os-unix", "src/parser");

   for Library_Dir use "lib/porion/" & Project'Library_Kind;
   for Object_Dir use "obj/porion/" & Project'Library_Kind;

   package binder is
      case Porion_Config.Mode is
         when "debug" =>
            for Default_Switches ("Ada") use ("-E");

         when others =>
            for Default_Switches ("Ada") use ("-E");

      end case;
   end binder;

   package Compiler renames Porion_Config.Compiler;

end Porion_Lib;
