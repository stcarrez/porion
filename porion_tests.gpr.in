with "porion_config";
with "@UTIL_DIR@utilada_sys";
with "@UTIL_DIR@utilada_unit";
with "@EL_DIR@elada";
with "@ADO_DIR@ado";

with "porion_lib";
with "agent/porion_agent";

project porion_Tests is

   Mains := ("porion_harness.adb");
   for Main use Mains;
   for Source_Dirs use ("regtests");
   for Object_Dir use "./" & Porion_Config'Object_Dir & "/obj/regtests";
   for Exec_Dir use "./" & Porion_Config'Exec_Dir & "/bin";

   package Binder renames Porion_Config.Binder;
   package Builder renames Porion_Config.Builder;
   package Compiler renames Porion_Config.Compiler;
   package Linker renames Porion_Config.Linker;

end porion_Tests;
