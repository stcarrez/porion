<?xml version="1.0" encoding="UTF-8"?>
<module version="1.0">

  <application>
    <message-bundle var='dashboardsMsg'>dashboards</message-bundle>
  </application>

  <managed-bean>
    <description>List of projects</description>
    <managed-bean-name>projectList</managed-bean-name>
    <managed-bean-class>Porion.Dashboards.Beans.Project_List_Bean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>

  <managed-bean>
    <description>Statistics about project last builds</description>
    <managed-bean-name>statLastBuilds</managed-bean-name>
    <managed-bean-class>Porion.Dashboards.Beans.Stats.Last_Builds_Bean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>

  <managed-bean>
    <description>Metrics about project builds</description>
    <managed-bean-name>metricLastBuilds</managed-bean-name>
    <managed-bean-class>Porion.Dashboards.Beans.Stats.Metrics_Bean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>

  <servlet-mapping>
    <servlet-name>api</servlet-name>
    <url-pattern>/api/*</url-pattern>
  </servlet-mapping>

  <filter-mapping>
    <filter-name>service</filter-name>
    <url-pattern>/dashboards/*.html</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>auth-filter</filter-name>
    <url-pattern>/dashboards/*.html</url-pattern>
  </filter-mapping>

  <url-policy>
    <permission>anonymous</permission>
    <url-pattern>/dashboards/.*\.html</url-pattern>
  </url-policy>

  <url-policy>
    <permission>logged-user</permission>
    <url-pattern>/dashboards/admin/.*</url-pattern>
  </url-policy>

</module>
