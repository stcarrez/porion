<?xml version="1.0" encoding="UTF-8"?>
<module version="1.0">

  <application>
    <message-bundle var='projectsMsg'>projects</message-bundle>
  </application>

  <managed-bean>
    <description>The project description and information</description>
    <managed-bean-name>project</managed-bean-name>
    <managed-bean-class>Porion.Projects.Beans.Projects_Bean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>

  <managed-bean>
    <description>Metrics about a project</description>
    <managed-bean-name>projectMetrics</managed-bean-name>
    <managed-bean-class>Porion.Dashboards.Beans.Stats.Metrics_Bean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>

  <navigation-rule>
    <from-view-id>/projects/view.xhtml</from-view-id>
    <navigation-case>
      <from-outcome>loaded</from-outcome>
      <to-view-id>/projects/view.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>not-visible</from-outcome>
      <to-view-id>/projects/no-project.xhtml</to-view-id>
      <status>403</status>      
    </navigation-case>
    <navigation-case>
      <from-outcome>not-found</from-outcome>
      <to-view-id>/projects/no-project.xhtml</to-view-id>
      <redirect/>
    </navigation-case>
    <navigation-case>
      <from-outcome>ado.objects.not_found</from-outcome>
      <to-view-id>/projects/no-project.xhtml</to-view-id>
      <redirect/>
    </navigation-case>
  </navigation-rule>

  <filter-mapping>
    <filter-name>service</filter-name>
    <url-pattern>/projects/*.html</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/summary</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/builds</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/xunits</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/coverage</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>auth-filter</filter-name>
    <url-pattern>/projects/*.html</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/summary</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/builds</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/xunits</url-pattern>
    <url-pattern>/projects/view/#{project.ident}/coverage</url-pattern>
  </filter-mapping>

  <url-policy>
    <permission>anonymous</permission>
    <url-pattern>/projects/.*\.html</url-pattern>
    <url-pattern>/projects/view/.*</url-pattern>
  </url-policy>

  <url-policy>
    <permission>logged-user</permission>
    <url-pattern>/projects/admin/.*</url-pattern>
  </url-policy>

  <url-mapping>
    <pattern>/projects/view/#{project.ident}/summary</pattern>
    <view-id>/projects/project-summary.html</view-id>
  </url-mapping>

  <url-mapping>
    <pattern>/projects/view/#{project.ident}/builds</pattern>
    <view-id>/projects/project-builds.html</view-id>
  </url-mapping>

  <url-mapping>
    <pattern>/projects/view/#{project.ident}/xunits</pattern>
    <view-id>/projects/project-xunits.html</view-id>
  </url-mapping>

  <url-mapping>
    <pattern>/projects/view/#{project.ident}/coverage</pattern>
    <view-id>/projects/project-coverage.html</view-id>
  </url-mapping>

</module>
