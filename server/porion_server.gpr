with "../porion_config";
with "utilada_sys";
with "elada";
with "servletada";
with "servletada_aws";
with "asf";
with "ado";
with "ado_sqlite";
with "awa";
with "awa_mail";
with "awa_setup";
with "openapi_server";

with "../porion_lib";
project Porion_Server is

   Mains := ("porion-server.adb");
   for Main use Mains;
   for Source_Dirs use ("src", "src/model");
   for Object_Dir use "../" & Porion_Config'Object_Dir & "/obj/server";
   for Exec_Dir use "../" & Porion_Config'Exec_Dir & "/bin";

   package Binder renames Porion_Config.Binder;
   package Builder renames Porion_Config.Builder;
   package Compiler renames Porion_Config.Compiler;
   package Linker renames Porion_Config.Linker;

end Porion_Server;
