[build]
cloc

[log-ignore]
<\?xml version="1.0" encoding="UTF-8"\?><results>
<header>
  <cloc_url>github.com/AlDanial/cloc</cloc_url>
  <cloc_version>1.82</cloc_version>
  <elapsed_seconds>[0-9]+.[0-9]+</elapsed_seconds>
  <n_files>[0-9]+</n_files>
  <n_lines>[0-9]+</n_lines>
  <files_per_second>[0-9]+.[0-9]+</files_per_second>
  <lines_per_second>[0-9]+.[0-9]+</lines_per_second>
</header>
<languages>
  <language name=".*" files_count="[0-9]+" blank="[0-9]+" comment="[0-9]+" code="[0-9]+" />
  <total sum_files="[0-9]+" blank="[0-9]+" comment="[0-9]+" code="[0-9]+" />
</languages>
</results>
