[availability]
which git

[version]
git --version

[check]
git ls-remote -h -- #{repository_url}

[show_remote]
git remote show #{repository_url}

[checkout]
git clone #{not empty branch ? '-b' : ''} #{branch} --recursive #{repository_url} #{build_dir}

[guess]
git -C #{path} config remote.origin.url

[init]
git init --bare #{git_tmp_dir}

[log-ignore]
Cloning into .*
Submodule .*
