[availability]
which gprbuild

[version]
gprbuild --version | head -1

[command]
gprbuild

[log-ignore]
^Setup$
^Compile$
   \[mkdir\]   .*
   \[mkdirs\]   .*
   \[Ada\]    .*
   \[C\]      .*

[log-warning]
.*[0-9]+: warning:
.*[0-9]+: \(style\)

[log-error]
.*[0-9]+: error:

[log-info]
^gprbuild .*
^gprinstall .*
