[availability]
which make

[version]
make --version | head -1

[build]
make

[check]
test -f Makefile
test -f Makefile.in
test -f Makefile.am

[log-error]
^make\[[0-9]+\]: \*\*\* \[.*\] Error.*
^make: \*\*\*

[log-context]
^make\[[0-9]+\]: Leaving directory '.*'
^make\[[0-9]+\]: Entering directory '.*'
