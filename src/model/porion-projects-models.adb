   --  ------------------------------
   --  Get the bean attribute identified by the name.
   --  ------------------------------
   overriding
   function Get_Value (From : in Branch_Ref;
                       Name : in String) return Util.Beans.Objects.Object is
      Obj  : ADO.Objects.Object_Record_Access;
      Impl : access Branch_Impl;
   begin
      if From.Is_Null then
         return Util.Beans.Objects.Null_Object;
      end if;
      Obj := From.Get_Load_Object;
      Impl := Branch_Impl (Obj.all)'Access;
      if Name = "id" then
         return ADO.Objects.To_Object (Impl.Get_Key);
      elsif Name = "name" then
         return Util.Beans.Objects.To_Object (Impl.Name);
      elsif Name = "tag" then
         return Util.Beans.Objects.To_Object (Impl.Tag);
      elsif Name = "last_date" then
         if Impl.Last_Date.Is_Null then
            return Util.Beans.Objects.Null_Object;
         else
            return Util.Beans.Objects.Time.To_Object (Impl.Last_Date.Value);
         end if;
      elsif Name = "create_date" then
         return Util.Beans.Objects.Time.To_Object (Impl.Create_Date);
      elsif Name = "update_date" then
         return Util.Beans.Objects.Time.To_Object (Impl.Update_Date);
      elsif Name = "status" then
         return Branch_Status_Type_Objects.To_Object (Impl.Status);
      elsif Name = "pass_rate" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Pass_Rate));
      elsif Name = "fail_rate" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Fail_Rate));
      elsif Name = "timeout_rate" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Timeout_Rate));
      elsif Name = "build_rate" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Build_Rate));
      elsif Name = "rate_factor" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Rate_Factor));
      elsif Name = "main_branch" then
         return Util.Beans.Objects.To_Object (Impl.Main_Branch);
      elsif Name = "last_build_number" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Last_Build_Number));
      elsif Name = "build_progress" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Build_Progress));
      elsif Name = "description" then
         return Util.Beans.Objects.To_Object (Impl.Description);
      end if;
      return Util.Beans.Objects.Null_Object;
   end Get_Value;


   procedure List (Object  : in out Branch_Vector;
                   Session : in out ADO.Sessions.Session'Class;
                   Query   : in ADO.SQL.Query'Class) is
      Stmt : ADO.Statements.Query_Statement
        := Session.Create_Statement (Query, BRANCH_DEF'Access);
   begin
      Stmt.Execute;
      Branch_Vectors.Clear (Object);
      while Stmt.Has_Elements loop
         declare
            Item : Branch_Ref;
            Impl : constant Branch_Access := new Branch_Impl;
         begin
            Impl.Load (Stmt, Session);
            ADO.Objects.Set_Object (Item, Impl.all'Access);
            Object.Append (Item);
         end;
         Stmt.Next;
      end loop;
   end List;

