               if Result /= 0 then
                  raise ADO.Objects.UPDATE_ERROR;
               else
                  raise ADO.Objects.LAZY_LOCK;
               end if;
            end if;
            ADO.Audits.Save (Object, Session);
         end;
      end if;
   end Save;

   overriding
   procedure Create (Object  : in out Project_Impl;
                     Session : in out ADO.Sessions.Master_Session'Class) is
      Query : ADO.Statements.Insert_Statement
                  := Session.Create_Statement (PROJECT_DEF'Access);
      Result : Integer;
   begin
      Object.Version := 1;
      Session.Allocate (Id => Object);
      Query.Save_Field (Name  => COL_0_1_NAME, --  id
                        Value => Object.Get_Key);
      Query.Save_Field (Name  => COL_1_1_NAME, --  name
                        Value => Object.Name);
      Query.Save_Field (Name  => COL_2_1_NAME, --  version
                        Value => Object.Version);
      Query.Save_Field (Name  => COL_3_1_NAME, --  description
                        Value => Object.Description);
      Query.Save_Field (Name  => COL_4_1_NAME, --  create_date
                        Value => Object.Create_Date);
      Query.Save_Field (Name  => COL_5_1_NAME, --  update_date
                        Value => Object.Update_Date);
      Query.Save_Field (Name  => COL_6_1_NAME, --  status
                        Value => Integer (Project_Status_Type'Enum_Rep (Object.Status)));
      Query.Save_Field (Name  => COL_7_1_NAME, --  scm
                        Value => Integer (Porion.Source_Control_Type'Enum_Rep (Object.Scm)));
      Query.Save_Field (Name  => COL_8_1_NAME, --  scm_url
                        Value => Object.Scm_Url);
      Query.Save_Field (Name  => COL_9_1_NAME, --  pass_rate
                        Value => Integer (Object.Pass_Rate));
      Query.Save_Field (Name  => COL_10_1_NAME, --  fail_rate
                        Value => Integer (Object.Fail_Rate));
      Query.Save_Field (Name  => COL_11_1_NAME, --  timeout_rate
                        Value => Integer (Object.Timeout_Rate));
      Query.Save_Field (Name  => COL_12_1_NAME, --  build_rate
                        Value => Integer (Object.Build_Rate));
      Query.Save_Field (Name  => COL_13_1_NAME, --  check_date
                        Value => Object.Check_Date);
      Query.Save_Field (Name  => COL_14_1_NAME, --  check_delay
                        Value => Object.Check_Delay);
      Query.Save_Field (Name  => COL_15_1_NAME, --  next_check_date
                        Value => Object.Next_Check_Date);
      Query.Save_Field (Name  => COL_16_1_NAME, --  build_progress
                        Value => Integer (Object.Build_Progress));
      Query.Execute (Result);
      if Result /= 1 then
         raise ADO.Objects.INSERT_ERROR;
      end if;
      ADO.Objects.Set_Created (Object);
      ADO.Audits.Save (Object, Session);
   end Create;

