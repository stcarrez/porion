   procedure Save (Object  : in out Test_Run_Impl;
                   Session : in out ADO.Sessions.Master_Session'Class) is
      Stmt : ADO.Statements.Update_Statement
         := Session.Create_Statement (TEST_RUN_DEF'Access);
   begin
      if Object.Is_Modified (5) then
         Stmt.Save_Field (Name  => COL_4_4_NAME, --  test_id
                          Value => Object.Test);
         Object.Clear_Modified (5);
      end if;
      if Object.Is_Modified (6) then
         Stmt.Save_Field (Name  => COL_5_4_NAME, --  group_id
                          Value => Object.Group);
         Object.Clear_Modified (6);
      end if;
      if Stmt.Has_Save_Fields then
         Stmt.Set_Filter (Filter => "id = ?");
         Stmt.Add_Param (Value => Object.Get_Key);
         declare
            Result : Integer;
         begin
            Stmt.Execute (Result);
            if Result /= 1 then
               if Result /= 0 then
                  raise ADO.Objects.UPDATE_ERROR;
               end if;
            end if;
         end;
      end if;
   end Save;

   procedure Create (Object  : in out Test_Run_Impl;
                     Session : in out ADO.Sessions.Master_Session'Class) is
