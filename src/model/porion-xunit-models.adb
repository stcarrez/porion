                        Value => Object.Assertions);
      Query.Save_Field (Name  => COL_4_4_NAME, --  test_id
                        Value => Object.Test);
      Query.Save_Field (Name  => COL_5_4_NAME, --  group_id
                        Value => Object.Group);
      Query.Execute (Result);
      if Result /= 1 then
         raise ADO.Objects.INSERT_ERROR;
      end if;
