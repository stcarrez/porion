   --  ------------------------------
   --  Get the bean attribute identified by the name.
   --  ------------------------------
   overriding
   function Get_Value (From : in Test_Run_Ref;
                       Name : in String) return Util.Beans.Objects.Object is
      Obj  : ADO.Objects.Object_Record_Access;
      Impl : access Test_Run_Impl;
   begin
      if From.Is_Null then
         return Util.Beans.Objects.Null_Object;
      end if;
      Obj := From.Get_Load_Object;
      Impl := Test_Run_Impl (Obj.all)'Access;
      if Name = "duration" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Duration));
      elsif Name = "status" then
         return Test_Status_Type_Objects.To_Object (Impl.Status);
      elsif Name = "id" then
         return ADO.Objects.To_Object (Impl.Get_Key);
      elsif Name = "assertions" then
         return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Assertions));
      end if;
      return Util.Beans.Objects.Null_Object;
   end Get_Value;



