            return Util.Beans.Objects.Time.To_Object (Impl.Last_Timeout_Date.Value);
         end if;
      elsif Name = "last_pass_build" then
         if Impl.Last_Pass_Build.Is_Null then
            return Util.Beans.Objects.Null_Object;
         else
            return Util.Beans.Objects.To_Object (Long_Long_Integer (Impl.Last_Pass_Build.Value));
